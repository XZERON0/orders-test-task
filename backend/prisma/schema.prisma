generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id       String    @id @default(cuid())
  name     String
  users    User[]
  products Product[]
  orders   Order[]

  @@map("organizations")
}

model User {
  id             String       @id @default(cuid())
  name           String
  /// Упрощённая авторизация для тестового: токен передаётся в заголовке Authorization
  token          String       @unique
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("users")
}

model Product {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  sku            String
  price          Decimal      @db.Decimal(12, 2)
  stock          StockItem?
  lines          OrderLine[]

  @@unique([organizationId, sku])
  @@map("products")
}

/// Остаток товара на складе. Один склад на организацию.
/// onHand — физически на полке, reserved — обещано подтверждённым заказам.
model StockItem {
  productId String  @id @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  onHand    Int     @default(0) @map("on_hand")
  reserved  Int     @default(0)

  @@map("stock_items")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  CANCELLED
}

model Order {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id])
  /// Номер заказа внутри организации: 1, 2, 3…
  number          Int
  customerName    String       @map("customer_name")
  status          OrderStatus  @default(DRAFT)
  discountPercent Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  total           Decimal      @db.Decimal(12, 2)
  createdAt       DateTime     @default(now()) @map("created_at")
  lines           OrderLine[]

  @@unique([organizationId, number])
  @@map("orders")
}

model OrderLine {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  /// Сумма строки с учётом скидки заказа
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)

  @@map("order_lines")
}
